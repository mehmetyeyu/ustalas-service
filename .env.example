# Neon PostgreSQL bağlantı URL'si
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=cok_gizli_bir_anahtar_buraya_degistir
JWT_EXPIRES_IN=12h

# Web Push — bir kere üret (`npx web-push generate-vapid-keys`), her ortama
# (lokal + Vercel Production/Preview/Development) aynı değerleri ekle.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY, VAPID_PUBLIC_KEY ile AYNI değer olmalı.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@ornek.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# iyzico Abonelik (SaaS faturalandırma, bkz. ~/.claude/plans/golden-jingling-spindle.md)
# Sandbox: https://sandbox-api.iyzipay.com — sandbox-merchant.iyzipay.com/auth/register'dan alınır.
# Production: https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# scripts/iyzico-setup.mjs çıktısından (tek seferlik kurulum)
IYZICO_PRODUCT_REF=
IYZICO_PLAN_MONTHLY_REF=
IYZICO_PLAN_YEARLY_REF=
# Webhook imza doğrulaması (X-IYZ-SIGNATURE-V3) iyzico entegrasyon ekibi
# (entegrasyon@iyzico.com) tarafından açılana kadar bu ikisi boş/false
# kalmalı — açık değilse webhook hiçbir state değişikliği yapmaz.
IYZICO_MERCHANT_ID=
IYZICO_WEBHOOK_SIGNATURE_ENABLED=false
